<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="voicelogica.CallButton">
        <a href="#" class="o_voicelogica_call ms-3 d-inline-flex align-items-center text-nowrap" t-att-title="title" t-on-click.prevent="onClick">
            <i class="fa fa-phone" role="img" aria-hidden="true"/><small class="fw-bold ms-1">VoiceLogica</small>
        </a>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <VoiceLogicaCallButton t-if="props.record.data[props.name]" record="props.record" name="props.name"/>
        </xpath>
    </t>
</templates>
