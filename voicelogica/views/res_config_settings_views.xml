<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_voicelogica" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.voicelogica</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting string="VoiceLogica" id="voicelogica_setting" help="Click to call any phone number with VoiceLogica. Create the API key in VoiceLogica under Team and access &gt; API Keys.">
                    <div class="content-group mt-2">
                        <div class="row">
                            <label for="voicelogica_api_key" string="API key" class="col-lg-3 o_light_label"/>
                            <field name="voicelogica_api_key" password="True" class="col-lg-8"/>
                        </div>
                        <div class="row" groups="base.group_no_one">
                            <label for="voicelogica_api_url" string="Server" class="col-lg-3 o_light_label"/>
                            <field name="voicelogica_api_url" class="col-lg-8"/>
                        </div>
                        <button name="action_voicelogica_test" type="object" string="Test connection" icon="oi-arrow-right" class="btn-link mt-2" invisible="not voicelogica_api_key"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
