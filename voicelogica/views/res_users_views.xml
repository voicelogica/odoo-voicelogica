<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_simple_modif_voicelogica" model="ir.ui.view">
        <field name="name">res.users.preferences.form.voicelogica</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="voicelogica_email" readonly="0" placeholder="Same as your Odoo email"/>
            </xpath>
        </field>
    </record>
</odoo>
